<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bilvaerksted.ViewModels"
             xmlns:models="clr-namespace:Bilvaerksted.Models"
             x:Class="Bilvaerksted.Views.SeFakturaerPage"
             x:DataType="vm:SeFakturaerViewModel"
             Title="Fakturaer">

    <Grid RowDefinitions="Auto,*" Padding="20" MaximumWidthRequest="600">

        <Button Grid.Row="0" Text="Vis fakturaer" Command="{Binding HentFakturaerCommand}" Style="{StaticResource GemKnap}" Margin="0,0,0,10" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Fakturaer}">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Faktura">
                    <Border Style="{StaticResource Kort}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Id, StringFormat='Faktura nr. {0}'}" Style="{StaticResource KortTitel}" />
                            <Label Text="{Binding OrdreNr, StringFormat='Ordre nr. {0}'}" />
                            <Label Text="{Binding Dato, StringFormat='Dato: {0:dd-MM-yyyy}'}" />
                            <Label Text="{Binding MekanikerNavn, StringFormat='Mekaniker: {0}'}" />
                            <Label Text="{Binding Materialer, StringFormat='Materialer: {0}'}" />
                            <Label Text="{Binding MaterialePris, StringFormat='Pris for materialer: {0:N2} kr.'}" />
                            <Label Text="{Binding Timer, StringFormat='Timer: {0}'}" />
                            <Label Text="{Binding Timepris, StringFormat='Timepris: {0:N2} kr.'}" />
                            <Label Text="{Binding Total, StringFormat='Total: {0:N2} kr.'}" FontAttributes="Bold" FontSize="16" Margin="0,6,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="Ingen fakturaer endnu" Style="{StaticResource Undertitel}" Margin="0,20" />
            </CollectionView.EmptyView>

        </CollectionView>
    </Grid>
</ContentPage>
