<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bilvaerksted.ViewModels"
             x:Class="Bilvaerksted.Views.BookOpgavePage"
             x:DataType="vm:BookOpgaveViewModel"
             Title="Book opgave">

    <ScrollView>
        <Border Style="{StaticResource Kort}" Margin="20" MaximumWidthRequest="600">
            <VerticalStackLayout Spacing="5">

                <Label Text="Kundens navn" Style="{StaticResource FeltLabel}" />
                <Entry Placeholder="Fx Jens Hansen" Text="{Binding Navn}" />

                <Label Text="Adresse" Style="{StaticResource FeltLabel}" />
                <Entry Placeholder="Fx Vestergade 1, 8000 Aarhus" Text="{Binding Adresse}" />

                <Label Text="Bilmærke" Style="{StaticResource FeltLabel}" />
                <Entry Placeholder="Fx Toyota" Text="{Binding Bilmaerke}" />

                <Label Text="Model" Style="{StaticResource FeltLabel}" />
                <Entry Placeholder="Fx Yaris" Text="{Binding Model}" />

                <Label Text="Registreringsnummer" Style="{StaticResource FeltLabel}" />
                <Entry Placeholder="Fx AB 12 345" Text="{Binding Indregistreringsnummer}" />

                <Label Text="Indlevering" Style="{StaticResource FeltLabel}" />
                <DatePicker Date="{Binding IndleveringsDato}" />
                <TimePicker Time="{Binding IndleveringsTid}" />

                <Label Text="Hvad skal laves" Style="{StaticResource FeltLabel}" />
                <Editor Placeholder="Fx service og olieskift" HeightRequest="100" Text="{Binding Note}" />

                <Button Text="Gem opgave" Command="{Binding GemCommand}" Style="{StaticResource GemKnap}" />

                <Label Text="{Binding StatusBesked}" Style="{StaticResource StatusLabel}" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
