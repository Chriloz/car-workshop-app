<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bilvaerksted.ViewModels"
             x:Class="Bilvaerksted.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Bilværksted">
<Grid>

    <Image Source="vaerksted.jpg"
           Aspect="AspectFill"
           Opacity="0.3" />

    <VerticalStackLayout Padding="30" Spacing="15" MaximumWidthRequest="500">

        <Label Text="Bilværksted" Style="{StaticResource Overskrift}" Margin="0,30,0,0" />
        <Label Text="Vælg hvad du vil gøre" Style="{StaticResource Undertitel}" />

        <Button Text="Book ny opgave" Command="{Binding GaaTilBookOpgaveCommand}" Style="{StaticResource MenuKnap}" />
        <Button Text="Kalender" Command="{Binding GaaTilKalenderCommand}" Style="{StaticResource MenuKnap}" />
        <Button Text="Lav faktura" Command="{Binding GaaTilLavFakturaCommand}" Style="{StaticResource MenuKnap}" />
        <Button Text="Se fakturaer" Command="{Binding GaaTilSeFakturaerCommand}" Style="{StaticResource MenuKnap}" />

    </VerticalStackLayout>

</Grid>
    
</ContentPage>
